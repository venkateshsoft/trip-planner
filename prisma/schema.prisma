generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Trip {
  id               String            @id @default(cuid())
  userId           String?
  city             String
  state            String?
  country          String
  googleMapsUrl    String?
  mapLatitude      Float?
  mapLongitude     Float?
  startingLocation String
  transportMode    TransportMode
  travelDays       Int
  startDate        DateTime
  endDate          DateTime
  currency         String            @default("USD")
  totalBudgetMinor Int
  hotelBudgetMinor Int
  foodBudgetMinor  Int
  travelerCount    Int               @default(1)
  adults           Int               @default(1)
  children         Int               @default(0)
  infants          Int               @default(0)
  hotelStarRating  Int?
  interests        String[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  itineraries      Itinerary[]
  destinations     TripDestination[]
  preferences      TripPreference[]
  expenses         Expense[]
  weatherSnapshots WeatherSnapshot[]

  @@index([startDate, endDate])
  @@index([userId])
}

model User {
  id          String           @id @default(cuid())
  email       String?          @unique
  displayName String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  trips       Trip[]
  preferences TripPreference[]
}

model TripDestination {
  id               String            @id @default(cuid())
  tripId           String
  sequence         Int
  city             String
  state            String?
  country          String
  address          String?
  latitude         Float?
  longitude        Float?
  canonicalKey     String
  arrivalDate      DateTime?
  departureDate    DateTime?
  source           String?
  sourceId         String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  trip             Trip              @relation(fields: [tripId], references: [id], onDelete: Cascade)
  places           Place[]
  hotels           Hotel[]
  restaurants      Restaurant[]
  weatherSnapshots WeatherSnapshot[]
  expenses         Expense[]

  @@unique([tripId, sequence])
  @@unique([tripId, canonicalKey])
  @@index([tripId])
}

model Place {
  id                    String           @id @default(cuid())
  destinationId         String?
  name                  String
  placeType             String           @default("ATTRACTION")
  address               String?
  latitude              Float?
  longitude             Float?
  rating                Float?
  reviewCount           Int?
  categories            String[]
  openingHours          Json?
  photos                Json?
  estimatedVisitMinutes Int?
  admissionPriceMinor   Int?
  currency              String?
  familySuitable        Boolean?
  source                String?
  sourceId              String?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  destination           TripDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([placeType])
  @@unique([destinationId, source, sourceId])
}

model Hotel {
  id                  String           @id @default(cuid())
  destinationId       String?
  name                String
  address             String?
  latitude            Float?
  longitude           Float?
  rating              Float?
  reviewCount         Int?
  starRating          Int?
  pricePerNightMinor  Int?
  estimatedTotalMinor Int?
  currency            String?
  availabilityStatus  String?
  amenities           String[]
  bookingUrl          String?
  source              String?
  sourceId            String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  destination         TripDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([starRating])
}

model Restaurant {
  id             String           @id @default(cuid())
  destinationId  String?
  name           String
  address        String?
  latitude       Float?
  longitude      Float?
  rating         Float?
  reviewCount    Int?
  cuisine        String[]
  priceLevel     Int?
  openingHours   Json?
  dietaryOptions String[]
  familySuitable Boolean?
  bookingUrl     String?
  source         String?
  sourceId       String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  destination    TripDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([destinationId])
  @@index([priceLevel])
}

model WeatherSnapshot {
  id                       String           @id @default(cuid())
  tripId                   String?
  destinationId            String?
  forecastDate             DateTime
  weatherCode              Int?
  temperatureMinC          Float?
  temperatureMaxC          Float?
  precipitationProbability Int?
  source                   String?
  fetchedAt                DateTime         @default(now())
  trip                     Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination              TripDestination? @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, forecastDate])
  @@index([tripId, forecastDate])
}

model TripPreference {
  id              String         @id @default(cuid())
  tripId          String?
  userId          String?
  interests       String[]
  cuisines        String[]
  pace            String?
  hotelStarRating Int?
  transportMode   TransportMode?
  constraints     String[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  trip            Trip?          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user            User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@index([userId])
}

model Expense {
  id            String           @id @default(cuid())
  tripId        String
  destinationId String?
  category      String
  description   String?
  amountMinor   Int
  currency      String
  estimated     Boolean          @default(true)
  occurredAt    DateTime?
  createdAt     DateTime         @default(now())
  trip          Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination   TripDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([tripId, occurredAt])
  @@index([destinationId])
}

model Itinerary {
  id                      String          @id @default(cuid())
  tripId                  String
  trip                    Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade)
  status                  ItineraryStatus @default(COMPLETED)
  totalEstimatedCostMinor Int
  budgetRemainingMinor    Int
  candidatePool           Json
  generatedAt             DateTime        @default(now())
  createdAt               DateTime        @default(now())
  days                    ItineraryDay[]

  @@index([tripId, generatedAt])
}

model ItineraryDay {
  id                 String          @id @default(cuid())
  itineraryId        String
  itinerary          Itinerary       @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  dayNumber          Int
  date               DateTime
  totalTravelSeconds Int
  estimatedCostMinor Int
  stops              ItineraryStop[]

  @@unique([itineraryId, dayNumber])
}

model ItineraryStop {
  id                        String       @id @default(cuid())
  dayId                     String
  day                       ItineraryDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  candidateId               String
  name                      String
  stopOrder                 Int
  startMinute               Int
  endMinute                 Int
  durationMinutes           Int
  travelFromPreviousSeconds Int
  travelFromPreviousMeters  Int
  estimatedCostMinor        Int
  locked                    Boolean      @default(false)
  latitude                  Float
  longitude                 Float
  candidateData             Json

  @@unique([dayId, stopOrder])
}

model ProviderCacheEntry {
  id        String   @id @default(cuid())
  provider  String
  cacheKey  String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider, cacheKey])
  @@index([expiresAt])
}

enum TransportMode {
  WALKING
  BICYCLING
  TRANSIT
  DRIVING
}

enum ItineraryStatus {
  COMPLETED
  PARTIAL
}

